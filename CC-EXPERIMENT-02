EXPERIMENT-02
AIM: To implement a FIFO queue using only two stacks and perform the basic queue operations: push, pop, peek, and empty.

ALGORITHM:
Create two stacks: s1 and s2.
Push(x):
Push x into s1.
Pop():
If s2 is empty, transfer all elements from s1 to s2.
Pop and return the top element of s2.
Peek():
If s2 is empty, transfer all elements from s1 to s2.
Return the top element of s2.
Empty():
Return true if both s1 and s2 are empty.
This gives amortized O(1) time per operation

CODE:
#include <iostream>
#include <stack>
using namespace std;

class MyQueue {
private:
    stack<int> s1, s2;

    void transfer() {
        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }
    }

public:
    // Push element to the back
    void push(int x) {
        s1.push(x);
    }

    // Remove and return front element
    int pop() {
        transfer();
        int x = s2.top();
        s2.pop();
        return x;
    }

    // Return front element
    int peek() {
        transfer();
        return s2.top();
    }

    // Check whether queue is empty
    bool empty() {
        return s1.empty() && s2.empty();
    }
};

int main() {
    MyQueue myQueue;

    myQueue.push(1);
    myQueue.push(2);

    cout << myQueue.peek() << endl;   // 1
    cout << myQueue.pop() << endl;    // 1
    cout << myQueue.empty() << endl;  // 0

    return 0;
}
