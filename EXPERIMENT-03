EXPERIMENT-03
AIM: To find the middle node of a singly linked list using the two-pointer (slow and fast pointer) technique. If there are two middle nodes, return the second middle node.

ALGORITHM:
Create two pointers, slow and fast, and initialize both to head.
Traverse the linked list using:
Move slow one step at a time.
Move fast two steps at a time.
Continue until fast becomes NULL or fast->next becomes NULL.
When the loop ends, slow points to the middle node.
Return slow.
For an even-sized list, slow will point to the second middle node.

CODE:
#include <iostream>
using namespace std;

struct ListNode {
    int val;
    ListNode* next;

    ListNode(int x) {
        val = x;
        next = NULL;
    }
};

class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        ListNode* slow = head;
        ListNode* fast = head;

        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;
            fast = fast->next->next;
        }

        return slow;
    }
};

int main() {
    // Creating linked list: 1 -> 2 -> 3 -> 4 -> 5 -> 6
    ListNode* head = new ListNode(1);
    head->next = new ListNode(2);
    head->next->next = new ListNode(3);
    head->next->next->next = new ListNode(4);
    head->next->next->next->next = new ListNode(5);
    head->next->next->next->next->next = new ListNode(6);

    Solution obj;

    ListNode* middle = obj.middleNode(head);

    cout << "Middle node: " << middle->val << endl;

    return 0;
}
